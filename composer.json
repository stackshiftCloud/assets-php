{
  "name": "stackshift/assets",
  "description": "Official StackShift Assets SDK for PHP and Laravel",
  "type": "library",
  "homepage": "https://docs.stackshift.cloud",
  "keywords": ["stackshift", "assets", "mail", "laravel", "sdk"],
  "authors": [{ "name": "StackShift", "email": "support@stackshift.cloud" }],
  "support": { "email": "support@stackshift.cloud", "docs": "https://docs.stackshift.cloud", "source": "https://github.com/stackshiftCloud/assets-php" },
  "require": { "php": ">=8.2", "ext-curl": "*", "ext-json": "*" },
  "autoload": { "psr-4": { "StackShift\\": "src/" } },
  "suggest": { "illuminate/support": "Registers AssetsClient automatically in Laravel applications" },
  "extra": { "laravel": { "providers": ["StackShift\\Laravel\\StackShiftAssetsServiceProvider"] } }
}
